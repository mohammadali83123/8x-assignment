# Supabase (https://supabase.com/dashboard -> your project)

# Project URL: Project Settings -> Data API (looks like https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...): Project Settings -> API Keys -> "Publishable key".
# Safe for the browser because every table is protected by RLS. The variable keeps the
# ANON name for compatibility with @supabase/ssr; the legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...): Project Settings -> API Keys -> "Secret keys". Server only.
# Used by scripts/seed.ts and trusted server code. Bypasses RLS. Never commit or expose it.
# (The legacy service_role key also works here.)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (auth redirects, Stripe return URLs). Use the Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test mode. Leave empty to use the mock "Place order" flow.
STRIPE_SECRET_KEY=
